{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:vercel && tsc -b && npm run build:client && npm run build:server && npm run verify:ssr && npm run prerender && npm run verify:prerender",
    "configure:vercel": "node scripts/configure-vercel.mjs --write",
    "verify:vercel": "node scripts/configure-vercel.mjs",
    "build:client": "vite build --manifest",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "verify:ssr": "node scripts/smoke-ssr.mjs",
    "prerender": "node scripts/prerender.mjs",
    "verify:prerender": "node scripts/verify-prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
